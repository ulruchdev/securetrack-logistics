# ============================================================
#  Configuration locale CBS Logistics (dev)
#  Copier ce fichier vers `.env` (ignoré par git) et adapter
#  les valeurs si nécessaire :  cp .env.example .env
# ============================================================

# PostgreSQL
POSTGRES_USER=cbsuser
POSTGRES_PASSWORD=cbspassword
POSTGRES_DB=cbsdb

# MongoDB
MONGO_USER=cbsuser
MONGO_PASSWORD=cbspassword

# ============================================================
#  Variables des services (nécessaires pour les lancer via Maven)
#  Les mots de passe sont OBLIGATOIRES : plus aucun défaut en dur
#  dans le code — les services refusent de démarrer sans eux.
# ============================================================
DB_URL=jdbc:postgresql://localhost:5433/cbsdb
DB_USERNAME=cbsuser
DB_PASSWORD=<changez-moi>
MONGO_URI=mongodb://cbsuser:<changez-moi>@localhost:27017/cbsdb?authSource=admin
SECURITY_USERNAME=admin
SECURITY_PASSWORD=<changez-moi>
